{
  "target": "spring-node",
  "title": "Spring Boot service + React/Vite frontend + shaded library, shipped as one Boot jar on a Temurin JRE image",
  "build": "scripts/build.sh",
  "ecosystems": [
    "maven",
    "npm"
  ],
  "stages": {
    "source": {
      "path": ".",
      "maven": "aggregate",
      "npm": "frontend",
      "exclude": [
        "/normalizer/target",
        "/service/target",
        "/target",
        "/frontend/dist",
        "/trace-output",
        "/ship-check",
        "/work"
      ],
      "exclude_note": "paths removed from the scratch copy scanners see at source stage: build outputs and caches only, anchored to the project root so node_modules/*/dist and the like stay intact"
    },
    "artefact": {
      "path": "service/target/service-1.0.0.jar",
      "kind": "jar",
      "embedded_jars": "BOOT-INF/lib/"
    },
    "image": {
      "dockerfile": "Dockerfile",
      "context": ".",
      "tag": "criteria-spring-node:local"
    }
  },
  "shipped": [
    {
      "purl": "pkg:maven/dev.noregressions.trace/service@1.0.0",
      "note": "primary component (Boot jar)"
    },
    {
