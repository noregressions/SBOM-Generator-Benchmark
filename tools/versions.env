# The canonical tool set. One place for every version the benchmark uses: image/Dockerfile installs from it,
# criteria/generate.sh reads the Maven plugin coordinates from it, and scripts/evaluate records it beside the scores.
# To upgrade a tool: change the line, run make, and review the diff in criteria/SCORECARD.md.

# --- toolchains (they build the test cases, so their versions shape the results as much as the tools' do) ---
PYTHON_IMAGE=python:3.15.2-slim-trixie
JDK_VERSION=25.0.2+10
MAVEN_VERSION=3.9.16
NODE_VERSION=26.13.0
DOTNET_SDK_VERSION=10.0.404
GO_VERSION=1.27.4
DOCKER_CLI_VERSION=29.9.3
DOCKER_BUILDX_VERSION=0.38.2

# --- SBOM generators ---
SYFT_VERSION=1.51.0
TRIVY_VERSION=0.74.0
CDXGEN_VERSION=11.3.2
SBOM_TOOL_VERSION=4.1.13
BOM_VERSION=0.8.0
CYCLONEDX_NPM_VERSION=6.0.1
CYCLONEDX_PY_VERSION=8.0.1
SBOM4PYTHON_VERSION=0.12.6
CYCLONEDX_GOMOD_VERSION=1.12.0
# CaPyCLI needs a Python older than the image's (it supports < 3.15), so it gets its own, installed by uv
CAPYCLI_VERSION=2.12.0
CAPYCLI_PYTHON=3.14
UV_VERSION=0.13.7
DOCKER_SCOUT_VERSION=1.24.0
# Maven plugins are fetched by Maven, not installed in the image
CYCLONEDX_MAVEN_PLUGIN=org.cyclonedx:cyclonedx-maven-plugin:2.9.1
SBOM_PLUS_MAVEN_PLUGIN=dev.noregressions:sbom-plus-maven-plugin:1.1.0

# --- scoring and consumers ---
SBOMQS_VERSION=2.1.3
CYCLONEDX_CLI_VERSION=0.33.1
GRYPE_VERSION=0.115.0
